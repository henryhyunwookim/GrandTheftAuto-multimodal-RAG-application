# ===========================================================================
# Environment Configuration Template for GTA Multimodal RAG Application
# ===========================================================================
# Copy this file to '.env' and fill in your personal credentials:
#   copy .env.example .env

# Google Gemini API Key (Required for multimodal description and scene analysis)
# Obtain your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Gemini Model for Multimodal Analysis (Optional; defaults to gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash
